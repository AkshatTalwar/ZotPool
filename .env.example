# The app runs with in-memory demo data when these services stay commented out.
# Uncomment them when PostgreSQL and Redis are running locally.
# DATABASE_URL=postgresql://zotpool:zotpool@localhost:5432/zotpool
# REDIS_URL=redis://localhost:6379

# Optional integrations
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Realtime status service
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8081
REALTIME_PORT=8081
