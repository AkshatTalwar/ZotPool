{
  "name": "zotpool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:realtime": "tsx server/realtime.ts",
    "build": "next build",
    "build:lambda": "esbuild ./infra/lambda/match-handler.ts --bundle --platform=node --target=node20 --format=cjs --outfile=.lambda-dist/index.js",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc tests/matching.test.ts tests/validation.test.ts src/domain/matching.ts src/domain/types.ts src/domain/validation.ts --outDir .test-dist --module commonjs --moduleResolution node --target es2020 --esModuleInterop --skipLibCheck && node --test .test-dist/tests/matching.test.js .test-dist/tests/validation.test.js"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.6",
    "@react-google-maps/api": "^2.20.5",
    "@tsparticles/react": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "ioredis": "^5.4.2",
    "next": "^16.3.0",
    "openai": "^7.4.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-tsparticles": "^2.12.2",
    "tsparticles": "^3.8.0",
    "tsparticles-engine": "^2.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
